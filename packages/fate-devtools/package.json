{
  "name": "@nkzw/fate-devtools",
  "version": "1.16.1",
  "description": "Devtools for fate, with a Vite DevTools panel.",
  "homepage": "https://github.com/nkzw-tech/fate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/fate"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "@nkzw/source": "./src/index.ts",
      "default": "./lib/index.mjs"
    },
    "./react": {
      "types": "./lib/react.d.mts",
      "@nkzw/source": "./src/react.tsx",
      "default": "./lib/react.mjs"
    },
    "./vite": {
      "types": "./lib/vite.d.mts",
      "@nkzw/source": "./src/vite.ts",
      "default": "./lib/vite.mjs"
    }
  },
  "devDependencies": {
    "@nkzw/fate": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-fate": "workspace:*",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@nkzw/fate": "^1.16.0",
    "react": "^19.2.0",
    "react-fate": "^1.16.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-fate": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
