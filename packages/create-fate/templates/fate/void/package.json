{
  "name": "fate-app",
  "version": "0.0.1",
  "private": true,
  "description": "fate is a modern data client for React.",
  "author": "Christoph Nakazawa <christoph.pojer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/nkzw-tech/fate.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run fbtee:all && vp build",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "db:seed": "void db seed --file db/seed.ts",
    "dev": "vp dev",
    "dev:setup": "vp run fbtee:all && vp run prepare:void && vp run db:seed && vp run fate:generate",
    "fate:generate": "vp exec fate generate",
    "fbtee:all": "vp run fbtee:collect && vp run fbtee:translate",
    "fbtee:collect": "vp exec fbtee collect",
    "fbtee:prepare": "vp run fbtee:collect && vp exec fbtee prepare-translations --source-strings source_strings.json --output-dir translations --locales de-DE ja-JP",
    "fbtee:translate": "vp exec fbtee translate --source-strings source_strings.json --output-dir src/translations --output-locale-style=bcp47",
    "prepare:void": "void prepare",
    "test:all": "vp check && vp test"
  },
  "dependencies": {
    "@nkzw/core": "^1.3.1",
    "@nkzw/fate": "latest",
    "@nkzw/stack": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@void/react": "^0.10.12",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fbtee": "^4.0.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-fate": "latest",
    "tailwind-merge": "^3.6.0",
    "void": "^0.10.12",
    "void-fate": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/fbtee-cli": "^4.0.0",
    "@nkzw/oxlint-config": "^2.0.1",
    "@nkzw/vite-plugin-fbtee": "^4.0.0",
    "@oxc-node/core": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "oxc-transform-react": "^0.147.0",
    "pg": "8.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.6"
}
