{
  "name": "fate-app",
  "version": "0.0.1",
  "private": true,
  "description": "fate is a modern data client for the web.",
  "author": "Christoph Nakazawa <christoph.pojer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/nkzw-tech/fate.git"
  },
  "type": "module",
  "scripts": {
    "build": "dotenv run -f server/.env -- vp run --filter '@app/client' --filter '@app/server' build",
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "cd client && vp dev",
    "dev:server": "cd server && vp run dev",
    "dev:setup": "vp run --filter '@app/client' --filter '@app/server' dev:setup && vp run fate:generate",
    "drizzle": "vp run --filter '@app/server' drizzle",
    "fate:generate": "vp run --filter '@app/client' fate:generate",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@app/server": "workspace:*",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^2.0.1",
    "@oxc-node/core": "^1.0.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "npm-run-all2": "^9.0.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
