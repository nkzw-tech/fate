{
  "name": "fate-app",
  "version": "0.0.1",
  "private": true,
  "description": "fate is a modern data client for React.",
  "author": "Christoph Nakazawa <christoph.pojer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/nkzw-tech/fate.git"
  },
  "type": "module",
  "scripts": {
    "build": "dotenv -e server/.env -- vp run --filter '@app/client' --filter '@app/server' build",
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "cd client && vp dev",
    "dev:server": "cd server && vp run dev",
    "dev:setup": "vp run --filter '@app/client' --filter '@app/server' dev:setup && vp run fate:generate",
    "fate:generate": "vp run --filter '@app/client' fate:generate",
    "prepare": "vp config",
    "prisma": "vp run --filter '@app/server' prisma"
  },
  "devDependencies": {
    "@app/server": "workspace:*",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^2.0.0",
    "@oxc-node/core": "^0.1.0",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all2": "^9.0.3",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.6"
}
