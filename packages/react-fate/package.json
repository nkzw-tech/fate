{
  "name": "react-fate",
  "version": "1.6.1",
  "description": "fate is a modern data client for React.",
  "homepage": "https://github.com/nkzw-tech/fate",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/fate"
  },
  "bin": {
    "fate": "./lib/cli.mjs"
  },
  "files": [
    "docs",
    "lib"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "@nkzw/source": "./src/index.tsx",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client.d.mts",
      "@nkzw/source": "./src/client.ts",
      "default": "./lib/client.mjs"
    },
    "./vite": {
      "types": "./lib/vite.d.mts",
      "@nkzw/source": "./src/vite.ts",
      "default": "./lib/vite.mjs"
    }
  },
  "dependencies": {
    "@nkzw/fate": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
