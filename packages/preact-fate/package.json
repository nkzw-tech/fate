{
  "name": "preact-fate",
  "version": "1.7.4",
  "description": "fate is a modern data client for Preact.",
  "homepage": "https://github.com/nkzw-tech/fate",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/fate"
  },
  "bin": {
    "fate": "./lib/cli.mjs"
  },
  "files": [
    "docs",
    "lib"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "@nkzw/source": "./src/index.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client.d.mts",
      "@nkzw/source": "./src/client.ts",
      "default": "./lib/client.mjs"
    },
    "./vite": {
      "types": "./lib/vite.d.mts",
      "@nkzw/source": "./src/vite.ts",
      "default": "./lib/vite.mjs"
    }
  },
  "scripts": {
    "build": "vp pack --tsconfig tsconfig.json -d lib --target=node24 src/index.ts src/client.ts src/cli.ts src/vite.ts"
  },
  "dependencies": {
    "@nkzw/fate": "workspace:*",
    "preact-suspense": "^0.3.2"
  },
  "devDependencies": {
    "preact": "11.0.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.7.0"
  },
  "peerDependencies": {
    "preact": "^11.0.0"
  }
}
