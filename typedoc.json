{
  "$schema": "https://typedoc.org/schema.json",
  "docsRoot": "./docs",
  "entryPoints": [
    "packages/fate/src/index.ts",
    "packages/fate/src/persistence.ts",
    "packages/fate/src/idempotency.ts",
    "packages/fate-indexeddb/src/index.ts",
    "packages/fate/src/server.ts",
    "packages/fate/src/server/drizzle.ts",
    "packages/fate/src/server/prisma.ts",
    "packages/fate/src/vite.ts",
    "packages/react-fate/src/index.tsx",
    "packages/vue-fate/src/index.ts"
  ],
  "excludeExternals": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "hideBreadcrumbs": true,
  "navigation": {
    "includeFolders": false
  },
  "out": "docs/api",
  "packageOptions": {
    "basePath": "./src"
  },
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "readme": "none",
  "sidebar": {
    "pretty": true
  },
  "tsconfig": "packages/docs-toolchain/tsconfig.json"
}
