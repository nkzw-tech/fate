    "@hono/node-server": "^2.1.5",
    "@nkzw/core": "^1.3.1",
    "@nkzw/define-env": "^1.1.0",
    "@nkzw/fate": "workspace:*",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-complexity": "^4.2.3",
    "@pothos/plugin-directives": "^4.3.3",
    "@pothos/plugin-prisma": "^4.17.0",
    "@pothos/plugin-relay": "^4.8.1",
    "@pothos/plugin-scope-auth": "^4.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^2.0.1",
    "@oxc-node/core": "^1.0.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "glob": "^13.0.6",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "prisma-json-types-generator": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "nodemonConfig": {
    "ext": "tsx",
    "watch": [
      "src/"
