{
  "name": "@nkzw/fate-server",
  "version": "0.0.0",
  "private": true,
  "author": "Christoph Nakazawa <christoph.pojer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/nkzw-tech/fate.git"
  },
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development OXC_TSCONFIG_PATH=../../tsconfig.json node_modules/.bin/nodemon -q -I --exec node --no-warnings --experimental-specifier-resolution=node --import @oxc-node/core/register --env-file .env src/index.tsx",
    "dev:setup": "vp exec prisma generate",
    "prisma": "prisma"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@nkzw/core": "^1.3.1",
    "@nkzw/define-env": "^1.1.0",
    "@nkzw/fate": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "1.7.2",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0"
  },
  "nodemonConfig": {
    "ext": "ts,tsx",
    "watch": [
      "src/"
    ]
  }
}
